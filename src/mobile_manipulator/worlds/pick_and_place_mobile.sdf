<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pick_and_place">
    <gravity>0 0 -9.81</gravity>
    <physics name="a1_1ms" type="gz">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <pose>0 0 5 0 0 0</pose>
      <direction>-0.4 0.3 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8 8</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8 8</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.32 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pick_support">
      <static>true</static>
      <pose>-0.044 -0.225 0.070 0 0 0</pose>
      <link name="support_link">
        <collision name="pick_support_collision">
          <geometry>
            <box>
              <size>0.032 0.032 0.140</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>100000</kp>
                <kd>1.0</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.0001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="pick_support_visual">
          <geometry>
            <box>
              <size>0.032 0.032 0.140</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.12 0.45 0.85 1</diffuse>
          </material>
        </visual>
        <sensor name="pick_support_contact_sensor" type="contact">
          <contact>
            <collision>pick_support_collision</collision>
            <topic>/pick_support/contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>200</update_rate>
        </sensor>
      </link>
    </model>
    <model name="place_support">
      <static>true</static>
      <pose>1.063 0.694 0.070 0 0 1.570796327</pose>
      <link name="support_link">
        <collision name="place_support_collision">
          <geometry>
            <box>
              <size>0.032 0.032 0.140</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>100000</kp>
                <kd>1.0</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.0001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="place_support_visual">
          <geometry>
            <box>
              <size>0.032 0.032 0.140</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.15 0.75 0.28 1</diffuse>
          </material>
        </visual>
        <visual name="target_ring">
          <pose>0 0 0.072 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.021</radius>
              <length>0.004</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.95 0.8 0.08 1</diffuse>
          </material>
        </visual>
        <sensor name="place_support_contact_sensor" type="contact">
          <contact>
            <collision>place_support_collision</collision>
            <topic>/place_support/contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>200</update_rate>
        </sensor>
      </link>
    </model>
    <model name="evidence_camera">
      <static>true</static>
      <pose>-0.65 -0.85 1.80 0 0.85 0.86</pose>
      <link name="camera_link">
        <sensor name="a1_evidence_camera" type="camera">
          <topic>/pick_place/evidence/image</topic>
          <update_rate>60</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image>
              <width>1280</width>
              <height>960</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
