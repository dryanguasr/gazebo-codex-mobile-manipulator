<?xml version="1.0"?>
<robot name="mobile_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="SlateGray"><color rgba="0.44 0.50 0.56 1"/></material>
  <material name="Black"><color rgba="0.04 0.04 0.04 1"/></material>
  <material name="PoppyOrange"><color rgba="1.0 0.32 0.05 1"/></material>
  <material name="ServoGray"><color rgba="0.28 0.30 0.32 1"/></material>
  <material name="Blue"><color rgba="0.1 0.25 0.9 1"/></material>

  <!-- Compact platform selected after validating the Poppy CAD at physical 1:1. -->
  <xacro:property name="base_length" value="0.40"/>
  <xacro:property name="base_width" value="0.30"/>
  <xacro:property name="base_height" value="0.10"/>
  <xacro:property name="base_mass" value="6.0"/>
  <xacro:property name="base_ixx" value="0.050"/>
  <xacro:property name="base_iyy" value="0.085"/>
  <xacro:property name="base_izz" value="0.125"/>
  <xacro:property name="wheel_radius" value="0.070"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_mass" value="0.45"/>
  <xacro:property name="wheel_ixx" value="0.000627"/>
  <xacro:property name="wheel_iyy" value="0.001103"/>
  <xacro:property name="wheel_izz" value="0.000627"/>
  <xacro:property name="wheel_x" value="0.140"/>
  <xacro:property name="wheel_y" value="0.1725"/>
  <xacro:property name="camera_x" value="0.225"/>
  <xacro:property name="camera_z" value="0.050"/>
  <xacro:property name="arm_mount_x" value="-0.030"/>
  <xacro:property name="arm_mount_z" value="0.050"/>

  <xacro:macro name="box" params="name xyz size mass ixx iyy izz color">
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="${xyz}"/>
        <geometry><box size="${size}"/></geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="${xyz}"/>
        <geometry><box size="${size}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:box
    name="base_link"
    xyz="0 0 0"
    size="${base_length} ${base_width} ${base_height}"
    mass="${base_mass}"
    ixx="${base_ixx}"
    iyy="${base_iyy}"
    izz="${base_izz}"
    color="SlateGray"
  />
  <link name="base_footprint"/>
  <joint name="base_fixed" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" iyy="${wheel_iyy}" izz="${wheel_izz}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin rpy="1.5707963267949 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="Black"/>
      </visual>
      <collision>
        <origin rpy="1.5707963267949 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20" velocity="12.0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="front_left" x="${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="rear_left" x="-${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="front_right" x="${wheel_x}" y="-${wheel_y}"/>
  <xacro:wheel name="rear_right" x="-${wheel_x}" y="-${wheel_y}"/>

  <!-- The printed Poppy base and motor m1 body remain fixed to the vehicle. -->
  <link name="poppy_mount_link">
    <inertial>
      <origin xyz="0 0 0.019"/>
      <mass value="0.0450"/>
      <inertia ixx="1.4e-5" iyy="1.3e-5" izz="1.7e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find mobile_manipulator)/meshes/poppy_ergo_jr/visual/poppy_mount.stl"/>
      </geometry>
      <material name="PoppyOrange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.027"/>
      <geometry><box size="0.024 0.027 0.036"/></geometry>
      <material name="ServoGray"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mobile_manipulator)/meshes/poppy_ergo_jr/collision/poppy_mount_convex.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="poppy_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="poppy_mount_link"/>
    <origin xyz="${arm_mount_x} 0 ${arm_mount_z}"/>
  </joint>

  <link name="poppy_link_1">
    <inertial>
      <origin xyz="0 0 0.024"/>
      <mass value="0.0390"/>
      <inertia ixx="8.6e-6" iyy="9.8e-6" izz="7.0e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find mobile_manipulator)/meshes/poppy_ergo_jr/visual/poppy_link_1.stl"/>
      </geometry>
      <material name="PoppyOrange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.024"/>
      <geometry><box size="0.024 0.027 0.036"/></geometry>
      <material name="ServoGray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.027"/>
      <geometry><box size="0.042 0.034 0.054"/></geometry>
    </collision>
  </link>
  <joint name="poppy_m1_joint" type="revolute">
    <parent link="poppy_mount_link"/>
    <child link="poppy_link_1"/>
    <origin xyz="0 0 0.0327993216120967" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" effort="0.39" velocity="2.0"/>
  </joint>

  <link name="poppy_link_2">
    <inertial>
      <origin xyz="0.042 0 0"/>
      <mass value="0.0383"/>
      <inertia ixx="5.0e-6" iyy="9.0e-6" izz="8.0e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find mobile_manipulator)/meshes/poppy_ergo_jr/visual/poppy_link_2.stl"/>
      </geometry>
      <material name="PoppyOrange"/>
    </visual>
    <visual>
      <origin xyz="0.054 0 0" rpy="0 1.5707963267949 0"/>
      <geometry><box size="0.027 0.024 0.036"/></geometry>
      <material name="ServoGray"/>
    </visual>
    <collision>
      <origin xyz="0.0415 0 0"/>
      <geometry><box size="0.050 0.030 0.040"/></geometry>
    </collision>
  </link>
  <joint name="poppy_m2_joint" type="revolute">
    <parent link="poppy_link_1"/>
    <child link="poppy_link_2"/>
    <origin xyz="0 0 0.0240006783879033" rpy="0 -1.5707963267949 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5708" upper="1.5708" effort="0.39" velocity="2.0"/>
  </joint>

  <link name="poppy_link_3">
    <inertial>
      <origin xyz="0.047 0 0"/>
      <mass value="0.0353"/>
      <inertia ixx="4.2e-6" iyy="5.0e-6" izz="4.5e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find mobile_manipulator)/meshes/poppy_ergo_jr/visual/poppy_link_3.stl"/>
      </geometry>
      <material name="PoppyOrange"/>
    </visual>
    <visual>
      <origin xyz="0.045 0 0" rpy="0 1.5707963267949 0"/>
      <geometry><box size="0.024 0.027 0.036"/></geometry>
      <material name="ServoGray"/>
    </visual>
    <collision>
      <origin xyz="0.045 0 0"/>
      <geometry><box size="0.040 0.032 0.036"/></geometry>
    </collision>
  </link>
  <joint name="poppy_m3_joint" type="revolute">
    <parent link="poppy_link_2"/>
    <child link="poppy_link_3"/>
    <origin xyz="0.054 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5708" upper="1.5708" effort="0.39" velocity="2.0"/>
  </joint>

  <link name="poppy_link_4">
    <inertial>
      <origin xyz="0 -0.042 0"/>
      <mass value="0.0383"/>
      <inertia ixx="9.0e-6" iyy="5.0e-6" izz="8.0e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find mobile_manipulator)/meshes/poppy_ergo_jr/visual/poppy_link_4.stl"/>
      </geometry>
      <material name="PoppyOrange"/>
    </visual>
    <visual>
      <origin xyz="0 -0.048 0" rpy="1.5707963267949 0 0"/>
      <geometry><box size="0.027 0.024 0.036"/></geometry>
      <material name="ServoGray"/>
    </visual>
    <collision>
      <origin xyz="0 -0.0415 0"/>
      <geometry><box size="0.040 0.050 0.030"/></geometry>
    </collision>
  </link>
  <joint name="poppy_m4_joint" type="revolute">
    <parent link="poppy_link_3"/>
    <child link="poppy_link_4"/>
    <origin xyz="0.045 0 0" rpy="0 -1.5707963267949 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5708" upper="1.5708" effort="0.39" velocity="2.0"/>
  </joint>

  <link name="poppy_link_5">
    <inertial>
      <origin xyz="0 -0.070 0.005"/>
      <mass value="0.0411"/>
      <inertia ixx="4.7e-5" iyy="8.0e-6" izz="4.8e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find mobile_manipulator)/meshes/poppy_ergo_jr/visual/poppy_link_5.stl"/>
      </geometry>
      <material name="PoppyOrange"/>
    </visual>
    <visual>
      <origin xyz="0 -0.058 0" rpy="0 -1.5707963267949 0"/>
      <geometry><box size="0.024 0.027 0.036"/></geometry>
      <material name="ServoGray"/>
    </visual>
    <collision>
      <origin xyz="0 -0.058 0"/>
      <geometry><box size="0.036 0.032 0.030"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.082 0.0145"/>
      <geometry><box size="0.024 0.092 0.006"/></geometry>
    </collision>
  </link>
  <joint name="poppy_m5_joint" type="revolute">
    <parent link="poppy_link_4"/>
    <child link="poppy_link_5"/>
    <origin xyz="0 -0.048 0" rpy="0 -1.5707963267949 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="0.39" velocity="2.0"/>
  </joint>

  <link name="poppy_link_6">
    <inertial>
      <origin xyz="-0.0035 -0.030 0"/>
      <mass value="0.00614"/>
      <inertia ixx="3.87e-6" iyy="9.72e-7" izz="3.65e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="file://$(find mobile_manipulator)/meshes/poppy_ergo_jr/visual/poppy_link_6.stl"/>
      </geometry>
      <material name="PoppyOrange"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find mobile_manipulator)/meshes/poppy_ergo_jr/collision/poppy_link_6_convex.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="poppy_m6_joint" type="revolute">
    <parent link="poppy_link_5"/>
    <child link="poppy_link_6"/>
    <origin xyz="0 -0.058 0" rpy="0 -1.5707963267949 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="1.20" effort="0.39" velocity="2.0"/>
  </joint>

  <link name="poppy_fixed_tip"/>
  <joint name="poppy_fixed_tip_joint" type="fixed">
    <parent link="poppy_link_5"/>
    <child link="poppy_fixed_tip"/>
    <origin xyz="0 -0.11 0" rpy="-1.5707963267949 0 0"/>
  </joint>
  <link name="poppy_moving_tip"/>
  <joint name="poppy_moving_tip_joint" type="fixed">
    <parent link="poppy_link_6"/>
    <child link="poppy_moving_tip"/>
    <origin xyz="0 -0.052 0" rpy="-1.5707963267949 0 0"/>
  </joint>

  <!-- The tracking camera stays on the vehicle front to preserve the A/B task. -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.08 0.12 0.06"/></geometry>
      <material name="Blue"/>
    </visual>
  </link>
  <joint name="camera_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 0 0"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="front_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="poppy_m1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="poppy_m2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="poppy_m3_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="poppy_m4_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="poppy_m5_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="poppy_m6_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <topic>/camera/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>20</far></clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find mobile_manipulator)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
