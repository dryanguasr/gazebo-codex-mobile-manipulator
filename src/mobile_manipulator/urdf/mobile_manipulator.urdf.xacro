<?xml version="1.0"?>
<robot name="mobile_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="pi" value="3.14159265359"/>
  <xacro:macro name="box" params="name xyz size mass color">
    <link name="${name}"><inertial><mass value="${mass}"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry><material name="${color}"/></visual><collision><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry></collision></link>
  </xacro:macro>
  <xacro:box name="base_link" xyz="0 0 0" size="0.72 0.52 0.16" mass="18" color="SlateGray"/>
  <link name="base_footprint"/><joint name="base_fixed" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.16"/></joint>
  <xacro:macro name="wheel" params="name x y"><link name="${name}_link"><inertial><mass value="1.2"/><inertia ixx="0.006" iyy="0.006" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.115" length="0.07"/></geometry><material name="Black"/></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.115" length="0.07"/></geometry></collision></link><joint name="${name}_joint" type="continuous"><parent link="base_link"/><child link="${name}_link"/><origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/></joint></xacro:macro>
  <xacro:wheel name="front_left" x="0.25" y="0.30"/><xacro:wheel name="rear_left" x="-0.25" y="0.30"/><xacro:wheel name="front_right" x="0.25" y="-0.30"/><xacro:wheel name="rear_right" x="-0.25" y="-0.30"/>
  <xacro:box name="shoulder_link" xyz="0 0 0.13" size="0.18 0.18 0.26" mass="3" color="DarkOrange"/>
  <joint name="arm_base_yaw" type="revolute"><parent link="base_link"/><child link="shoulder_link"/><origin xyz="-0.05 0 0.08"/><axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="30" velocity="1.5"/></joint>
  <xacro:box name="upper_arm_link" xyz="0.17 0 0" size="0.34 0.14 0.14" mass="2.2" color="Goldenrod"/>
  <joint name="shoulder_pitch" type="revolute"><parent link="shoulder_link"/><child link="upper_arm_link"/><origin xyz="0 0 0.22"/><axis xyz="0 1 0"/><limit lower="-1.5" upper="1.5" effort="25" velocity="1.5"/></joint>
  <xacro:box name="forearm_link" xyz="0.15 0 0" size="0.30 0.12 0.12" mass="1.5" color="Khaki"/>
  <joint name="elbow_pitch" type="revolute"><parent link="upper_arm_link"/><child link="forearm_link"/><origin xyz="0.34 0 0"/><axis xyz="0 1 0"/><limit lower="-2.0" upper="2.0" effort="20" velocity="1.8"/></joint>
  <xacro:box name="wrist_link" xyz="0.10 0 0" size="0.20 0.10 0.10" mass="0.8" color="LightSteelBlue"/>
  <joint name="wrist_pitch" type="revolute"><parent link="forearm_link"/><child link="wrist_link"/><origin xyz="0.30 0 0"/><axis xyz="0 1 0"/><limit lower="-1.8" upper="1.8" effort="12" velocity="2.0"/></joint>
  <xacro:box name="left_finger" xyz="0.15 0.045 0" size="0.16 0.035 0.07" mass="0.12" color="Silver"/><xacro:box name="right_finger" xyz="0.15 -0.045 0" size="0.16 0.035 0.07" mass="0.12" color="Silver"/>
  <joint name="left_finger_joint" type="prismatic"><parent link="wrist_link"/><child link="left_finger"/><origin xyz="0.20 0.045 0"/><axis xyz="0 1 0"/><limit lower="0" upper="0.04" effort="8" velocity="0.1"/></joint><joint name="right_finger_joint" type="prismatic"><parent link="wrist_link"/><child link="right_finger"/><origin xyz="0.20 -0.045 0"/><axis xyz="0 1 0"/><limit lower="-0.04" upper="0" effort="8" velocity="0.1"/></joint>
  <link name="camera_link"><visual><geometry><box size="0.08 0.12 0.06"/></geometry><material name="Blue"/></visual></link><joint name="camera_fixed" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.38 0 0.10" rpy="0 0 0"/></joint>
  <ros2_control name="GazeboSimSystem" type="system"><hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware><joint name="front_left_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="rear_left_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="front_right_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="rear_right_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="arm_base_yaw"><command_interface name="position"/><state_interface name="position"/></joint><joint name="shoulder_pitch"><command_interface name="position"/><state_interface name="position"/></joint><joint name="elbow_pitch"><command_interface name="position"/><state_interface name="position"/></joint><joint name="wrist_pitch"><command_interface name="position"/><state_interface name="position"/></joint><joint name="left_finger_joint"><command_interface name="position"/><state_interface name="position"/></joint><joint name="right_finger_joint"><command_interface name="position"/><state_interface name="position"/></joint></ros2_control>
  <gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>$(find mobile_manipulator)/config/controllers.yaml</parameters></plugin></gazebo>
</robot>
