<?xml version="1.0"?>
<sdf version="1.9">
  <model name="eagle_camera">
    <static>true</static>
    <pose>-3 -5 7.5 0 0.814 0.7854</pose>
    <link name="camera_link">
      <sensor name="eagle_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/eagle/image_raw</topic>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>30</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
